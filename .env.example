# Scan scope (REQUIRED for URL scans): comma-separated domains you are authorized to scan
A11Y_ALLOWED_DOMAINS=example.com
# Directory containing approved local HTML files
A11Y_LOCAL_DIR=./data/approved_html
A11Y_MAX_PAGES=10
A11Y_TIMEOUT_S=30
A11Y_MIN_DELAY_S=2
A11Y_RESPECT_ROBOTS=true
A11Y_ALLOW_PRIVATE_HOSTS=false
A11Y_DB_PATH=./data/auditor.db
A11Y_AXE_PATH=./vendor/axe.min.js
# AI adapter: none | anthropic
A11Y_LLM_PROVIDER=none
A11Y_LLM_MODEL=claude-sonnet-5-5
A11Y_LLM_MAX_ITEMS=10
# Secrets live here / in your environment only. Never commit .env
ANTHROPIC_API_KEY=
